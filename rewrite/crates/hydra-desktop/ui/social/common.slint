// Pieces the friends window (pages/friends-window) and the chat window
// (pages/chat-window) share: their icons, the avatar with its status orb,
// the unread badge, the official seal, the typing dots and CSS easings.
import { Theme } from "../theme.slint";
import { Icon } from "../components/widgets.slint";

