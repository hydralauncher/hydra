// Library modals with their own layout: the add custom game modal
// (components/sidebar/sidebar-adding-custom-game-modal) and the scan games
// modal (components/header/scan-games-modal). Rust fills `LibraryModals`
// (library_modals.rs). Collection modals use the shared dialogs.
import { Theme } from "../../theme.slint";
import { HydraButton, Icon, ScrollBar, Spinner } from "../../components/widgets.slint";
import { TextField, CheckboxField } from "../../components/fields.slint";
import { Modal, ModalController } from "../../components/modal.slint";
import { T } from "../../globals.slint";

// One found game (scan-games-modal__game-item).
export struct ScanGameRow {
    title: string,
    path: string,
    icon: image,
    has-icon: bool,
}

// One choice button, laid out by Rust (flex-wrap: wrap, gap 8).
export struct ScanChoice {
    object-id: string,
    title: string,
    icon: image,
    has-icon: bool,
    picked: bool,
    x: length,
    y: length,
    width: length,
}

// An executable that matches several games (scan-games-modal__ambiguous-item).
export struct ScanAmbiguousRow {
    path: string,
    choices: [ScanChoice],
    // the wrapped choices' height
    choices-height: length,
}

export global LibraryModals {
    // "" | "custom-game" | "scan"
    in-out property <string> kind;
    // The window, blurred, under the backdrop.
    in property <image> backdrop;
    // Bumped by Rust to close with the exit animation.
    in-out property <int> close-request;

    // ---- SidebarAddingCustomGameModal
    in property <string> custom-path;
    in-out property <string> custom-title;
    // gameName.trim() && executablePath.trim()
    in property <bool> custom-valid;
    in property <bool> custom-adding;
    callback custom-browse();
    callback custom-title-edited(string);
    callback custom-add();

    // ---- ScanGamesModal
    in property <bool> scan-windows;
    // "automatic" | "manual"
    in-out property <string> scan-mode: "automatic";
    in property <[string]> scan-folders;
    in-out property <bool> scan-add-to-library: true;
    in property <bool> scanning;
    in property <bool> has-result;
    in property <[ScanAmbiguousRow]> scan-pending;
    in property <bool> scan-resolving;
    in property <bool> scan-has-picks;
    in property <string> scan-summary;
    in property <[ScanGameRow]> scan-games;
    // The ambiguous list's inner width, for wrapping the choices.
    callback scan-choices-width(length);
    callback scan-add-folder();
    callback scan-remove-folder(string);
    callback scan-start();
    callback scan-cancel();
    callback scan-again();
    callback scan-pick(string, string);
    callback scan-skip();
    callback scan-confirm-picks();
    // handleClose (the modal hides; a scan keeps running)
    callback closing();

    // ---- ClassicsOnboardingModal (three steps)
    in-out property <int> onboarding-step;
    in-out property <bool> onboarding-dont-show: true;
}

// classics-onboarding-modal.scss: a 195px illustration over the footer
// (copy, then the "don't show again" checkbox, progress pills and Next).
component ClassicsOnboardingContent inherits VerticalLayout {
    property <int> step: LibraryModals.onboarding-step;
    // __body: #070707, the step's art, object-fit: cover
    Rectangle {
        height: 195px;
        background: #070707;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            image-fit: cover;
            source: root.step == 0 ? @image-url("../../images/classics-onboarding/step1.png")
                : root.step == 1 ? @image-url("../../images/classics-onboarding/step2.png")
                : @image-url("../../images/classics-onboarding/step3.png");
        }
    }
    // __footer: padding 16, gap 32, border-top 1px rgba(255,255,255,.06)
    Rectangle {
        height: 1px;
        background: rgba(255, 255, 255, 0.06);
    }
    VerticalLayout {
        padding: 16px;
        padding-top: 16px;
        spacing: 32px;
        // __copy: gap 16, min-height 132
        VerticalLayout {
            spacing: 16px;
            min-height: 132px;
            alignment: start;
            Text {
                text: T.tr(root.step == 0 ? "classics_onboarding.step1_heading" : root.step == 1 ? "classics_onboarding.step2_heading" : "classics_onboarding.step3_heading");
                font-size: 20px;
                font-weight: 700;
                letter-spacing: 0.21px;
                color: #c0c1c7;
                wrap: word-wrap;
            }
            // line-height 1.5 (21px lines)
            Text {
                text: T.tr(root.step == 0 ? "classics_onboarding.step1_body" : root.step == 1 ? "classics_onboarding.step2_body" : "classics_onboarding.step3_body");
                font-size: Theme.body-size;
                letter-spacing: 0.14px;
                color: Theme.subtle;
                wrap: word-wrap;
                vertical-alignment: center;
                height: Math.max(1, Math.round(self.preferred-height / (14px * 1.362))) * 21px;
            }
        }
        // __actions: space-between, gap 16
        HorizontalLayout {
            spacing: 16px;
            // the checkbox at its max-content width (a wrapping label measures narrow)
            Rectangle {
                width: dont-show-measure.preferred-width + 28px;
                dont-show-measure := Text {
                    visible: false;
                    text: T.tr("classics_onboarding.dont_show_again");
                    font-size: Theme.body-size;
                }
                CheckboxField {
                    y: (parent.height - self.height) / 2;
                    label: T.tr("classics_onboarding.dont_show_again");
                    checked: LibraryModals.onboarding-dont-show;
                    toggled => {
                        LibraryModals.onboarding-dont-show = !LibraryModals.onboarding-dont-show;
                    }
                }
            }
            // __progress: 24x4 pills, gap 8 (space-between centers it between its neighbours)
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                alignment: center;
                for i in 3: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 24px;
                    height: 4px;
                    border-radius: 2px;
                    background: i <= root.step ? #c0c1c7 : #424244;
                    animate background { duration: 200ms; easing: ease; }
                }
            }
            HydraButton {
                text: root.step < 2 ? T.tr("classics_onboarding.next") : T.tr("classics_onboarding.explore");
                clicked => {
                    if (root.step < 2) {
                        LibraryModals.onboarding-step += 1;
                    } else {
                        LibraryModals.closing();
                        LibraryModals.close-request += 1;
                    }
                }
            }
        }
    }
}

// text-field-container: a label above the field (gap 8)
component LabeledText inherits VerticalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        font-size: Theme.body-size;
        color: Theme.body;
    }
    @children
}

component CustomGameContent inherits VerticalLayout {
    // __container: gap 24, min-width 500
    spacing: 24px;
    min-width: 500px;
    // __form: gap 16
    VerticalLayout {
        spacing: 16px;
        LabeledText {
            label: T.tr("sidebar.custom_game_modal_executable_path");
            // __text-field-wrapper: the field and the Browse button (gap 8)
            HorizontalLayout {
                spacing: 8px;
                TextField {
                    horizontal-stretch: 1;
                    read-only: true;
                    placeholder: T.tr("sidebar.custom_game_modal_select_executable");
                    text: LibraryModals.custom-path;
                }
                HydraButton {
                    kind: "outline";
                    icon: @image-url("../../icons/file-directory.svg");
                    text: T.tr("sidebar.custom_game_modal_browse");
                    enabled: !LibraryModals.custom-adding;
                    clicked => {
                        LibraryModals.custom-browse();
                    }
                }
            }
        }
        LabeledText {
            label: T.tr("sidebar.custom_game_modal_title");
            TextField {
                placeholder: T.tr("sidebar.custom_game_modal_enter_title");
                text <=> LibraryModals.custom-title;
                read-only: LibraryModals.custom-adding;
                opacity: LibraryModals.custom-adding ? Theme.disabled-opacity : 1;
                edited(text) => {
                    LibraryModals.custom-title-edited(text);
                }
            }
        }
    }
    // __actions: end, gap 16
    HorizontalLayout {
        alignment: end;
        spacing: 16px;
        HydraButton {
            kind: "outline";
            text: T.tr("sidebar.custom_game_modal_cancel");
            enabled: !LibraryModals.custom-adding;
            clicked => {
                LibraryModals.closing();
                LibraryModals.close-request += 1;
            }
        }
        HydraButton {
            kind: "primary";
            text: LibraryModals.custom-adding ? T.tr("sidebar.custom_game_modal_adding") : T.tr("sidebar.custom_game_modal_add");
            enabled: !LibraryModals.custom-adding && LibraryModals.custom-valid;
            clicked => {
                LibraryModals.custom-add();
            }
        }
    }
}

// A scrolled list with Hydra's scrollbar (overflow-y: auto, max-height).
component ScrollList inherits Rectangle {
    in property <length> limit;
    in property <length> content-height;
    property <length> offset;
    height: Math.min(root.content-height, root.limit);
    clip: true;
    TouchArea {
        scroll-event(event) => {
            if (root.content-height <= root.height) {
                return reject;
            }
            root.offset = -Math.clamp(-root.offset - event.delta-y, 0, root.content-height - root.height);
            accept
        }
    }
    Rectangle {
        y: root.offset;
        height: root.content-height;
        @children
    }
    if root.content-height > root.height: ScrollBar {
        x: parent.width - self.width;
        height: parent.height;
        content-height: root.content-height;
        viewport-height: root.height;
        content-y <=> root.offset;
    }
}

// scan-games-modal__mode-option
component ModeOption inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback activated();
    horizontal-stretch: 1;
    height: 35px;
    border-radius: 4px;
    background: root.active ? Theme.background : transparent;
    animate background { duration: 200ms; easing: ease; }
    Text {
        text: root.label;
        font-size: Theme.body-size;
        color: root.active || touch.has-hover ? Theme.body : Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 200ms; easing: ease; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// scan-games-modal__game-item: 32px icon, title and path (gap 12)
component GameRow inherits VerticalLayout {
    in property <ScanGameRow> game;
    in property <bool> last;
    padding-bottom: root.last ? 0 : 9px;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 32px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            clip: true;
            background: Theme.background;
            if root.game.has-icon: Image {
                width: parent.width;
                height: parent.height;
                source: root.game.icon;
                image-fit: cover;
            }
            if !root.game.has-icon: Icon {
                width: 16px;
                height: 16px;
                source: @image-url("../../icons/device-desktop.svg");
                color: Theme.body;
            }
        }
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.game.title;
                font-size: Theme.body-size;
                font-weight: 500;
                color: Theme.body;
                wrap: word-wrap;
            }
            Text {
                text: root.game.path;
                font-size: Theme.small-size;
                color: Theme.subtle;
                wrap: char-wrap;
            }
        }
    }
    if !root.last: Rectangle {
        height: 1px;
        background: Theme.border;
    }
}

// scan-games-modal__choice
component ChoiceButton inherits Rectangle {
    in property <ScanChoice> choice;
    callback activated();
    border-radius: 4px;
    border-width: 1px;
    border-color: root.choice.picked ? Theme.body : Theme.border;
    background: root.choice.picked ? Theme.background : transparent;
    animate background, border-color { duration: 200ms; easing: ease; }
    property <color> fg: root.choice.picked || touch.has-hover ? Theme.body : Theme.muted;
    HorizontalLayout {
        padding-left: 17px;
        padding-right: 17px;
        spacing: 8px;
        alignment: center;
        if root.choice.has-icon: Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.choice.icon;
                image-fit: cover;
            }
        }
        Text {
            text: root.choice.title;
            font-size: Theme.small-size;
            color: root.fg;
            vertical-alignment: center;
            animate color { duration: 200ms; easing: ease; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component ScanContent inherits VerticalLayout {
    // .scan-games-modal: gap 24, min-width 400
    spacing: 24px;
    min-width: 400px;
    property <bool> manual: !LibraryModals.scan-windows || LibraryModals.scan-mode == "manual";
    property <bool> picking: LibraryModals.has-result && LibraryModals.scan-pending.length > 0;

    // The options before a scan.
    if !LibraryModals.has-result && !LibraryModals.scanning && LibraryModals.scan-windows: Rectangle {
        // __mode-toggle: #0d0d0d, radius 4, padding 4, gap 4
        height: 43px;
        border-radius: 4px;
        background: Theme.dark-background;
        HorizontalLayout {
            padding: 4px;
            spacing: 4px;
            ModeOption {
                label: T.tr("header.scan_games_mode_automatic");
                active: LibraryModals.scan-mode == "automatic";
                activated => {
                    LibraryModals.scan-mode = "automatic";
                }
            }
            ModeOption {
                label: T.tr("header.scan_games_mode_manual");
                active: LibraryModals.scan-mode == "manual";
                activated => {
                    LibraryModals.scan-mode = "manual";
                }
            }
        }
    }
    if !LibraryModals.has-result && !LibraryModals.scanning && root.manual: VerticalLayout {
        // __folders: gap 8
        spacing: 8px;
        HorizontalLayout {
            spacing: 16px;
            Text {
                horizontal-stretch: 1;
                text: T.tr("header.scan_games_folders_title");
                font-size: Theme.body-size;
                font-weight: 500;
                color: Theme.body;
                vertical-alignment: center;
            }
            HydraButton {
                kind: "outline";
                icon: @image-url("../../icons/file-directory-14.svg");
                icon-size: 14px;
                text: T.tr("header.scan_games_add_folder");
                clicked => {
                    LibraryModals.scan-add-folder();
                }
            }
        }
        if LibraryModals.scan-folders.length > 0: Rectangle {
            // __folders-list: #0d0d0d, radius 4, padding 16, gap 8, max-height 160
            border-radius: 4px;
            background: Theme.dark-background;
            height: Math.min(160px, folders.preferred-height);
            ScrollList {
            limit: 160px;
            content-height: folders.preferred-height;
            folders := VerticalLayout {
                padding: 16px;
                spacing: 8px;
                for folder in LibraryModals.scan-folders: HorizontalLayout {
                    spacing: 16px;
                    Text {
                        horizontal-stretch: 1;
                        text: folder;
                        font-size: Theme.small-size;
                        color: Theme.body;
                        wrap: char-wrap;
                        vertical-alignment: center;
                    }
                    // __folder-remove: padding 4, radius 4, hover body + border bg
                    remove := Rectangle {
                        width: 22px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: remove-touch.has-hover ? Theme.border : transparent;
                        accessible-role: button;
                        accessible-label: T.tr("header.scan_games_remove_folder");
                        Icon {
                            width: 14px;
                            height: 14px;
                            source: @image-url("../../icons/x-14.svg");
                            color: remove-touch.has-hover ? Theme.body : Theme.muted;
                        }
                        remove-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                LibraryModals.scan-remove-folder(folder);
                            }
                        }
                    }
                }
            }
            }
        }
        if LibraryModals.scan-folders.length == 0: Text {
            text: T.tr("header.scan_games_folders_hint_manual");
            font-size: Theme.small-size;
            color: Theme.subtle;
            wrap: word-wrap;
        }
    }
    if !LibraryModals.has-result && !LibraryModals.scanning: CheckboxField {
        label: T.tr("header.scan_games_add_to_library");
        checked: LibraryModals.scan-add-to-library;
        toggled => {
            LibraryModals.scan-add-to-library = !LibraryModals.scan-add-to-library;
        }
    }

    // __scanning: centered, gap 16, padding 24px 0
    if LibraryModals.scanning && !LibraryModals.has-result: VerticalLayout {
        padding-top: 24px;
        padding-bottom: 24px;
        spacing: 16px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            // spin 2s linear infinite
            Rectangle {
                width: 24px;
                height: 24px;
                Icon {
                    width: 24px;
                    height: 24px;
                    source: @image-url("../../icons/sync-24.svg");
                    color: Theme.muted;
                    transform-rotation: Math.mod(animation-tick() / 2000ms, 1) * 360deg;
                }
            }
        }
        Text {
            text: T.tr("header.scan_games_in_progress");
            font-size: Theme.body-size;
            color: Theme.muted;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                width: Math.min(320px, self.preferred-width);
                text: T.tr("header.scan_games_in_progress_hint");
                font-size: Theme.small-size;
                color: Theme.subtle;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // __ambiguous: title, hint, the list (gap 8)
    if root.picking: VerticalLayout {
        spacing: 8px;
        Text {
            text: T.tr-count("header.scan_games_ambiguous_title", LibraryModals.scan-pending.length, []);
            font-size: Theme.body-size;
            font-weight: 500;
            color: Theme.body;
            wrap: word-wrap;
        }
        Text {
            text: T.tr("header.scan_games_ambiguous_hint");
            font-size: Theme.small-size;
            color: Theme.subtle;
            wrap: word-wrap;
        }
        Rectangle {
            border-radius: 4px;
            background: Theme.dark-background;
            changed width => {
                LibraryModals.scan-choices-width(self.width - 32px);
            }
            init => {
                LibraryModals.scan-choices-width(self.width - 32px);
            }
            height: Math.min(260px, pending.preferred-height);
            ScrollList {
                limit: 260px;
                content-height: pending.preferred-height;
                pending := VerticalLayout {
                    padding: 16px;
                    spacing: 16px;
                    for match[i] in LibraryModals.scan-pending: VerticalLayout {
                        spacing: 8px;
                        padding-bottom: i == LibraryModals.scan-pending.length - 1 ? 0 : 9px;
                        Text {
                            text: match.path;
                            font-size: Theme.small-size;
                            color: Theme.subtle;
                            wrap: char-wrap;
                        }
                        Rectangle {
                            height: match.choices-height;
                            for choice in match.choices: ChoiceButton {
                                x: choice.x;
                                y: choice.y;
                                width: choice.width;
                                height: 34px;
                                choice: choice;
                                activated => {
                                    LibraryModals.scan-pick(match.path, choice.object-id);
                                }
                            }
                        }
                        if i < LibraryModals.scan-pending.length - 1: Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                    }
                }
            }
        }
    }

    // __results: the summary and the games, or "no results"
    if LibraryModals.has-result && !root.picking && LibraryModals.scan-games.length > 0: VerticalLayout {
        spacing: 8px;
        Text {
            text: LibraryModals.scan-summary;
            font-size: Theme.body-size;
            color: Theme.body;
            wrap: word-wrap;
        }
        Rectangle {
            border-radius: 4px;
            background: Theme.dark-background;
            height: Math.min(340px, games.preferred-height);
            ScrollList {
                limit: 340px;
                content-height: games.preferred-height;
                games := VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    for game[i] in LibraryModals.scan-games: GameRow {
                        game: game;
                        last: i == LibraryModals.scan-games.length - 1;
                    }
                }
            }
        }
    }
    if LibraryModals.has-result && !root.picking && LibraryModals.scan-games.length == 0: VerticalLayout {
        padding-top: 16px;
        padding-bottom: 16px;
        Text {
            text: T.tr("header.scan_games_no_results");
            font-size: Theme.body-size;
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // __actions: end, gap 16
    HorizontalLayout {
        alignment: end;
        spacing: 16px;
        if root.picking: HydraButton {
            kind: "outline";
            text: T.tr("header.scan_games_ambiguous_skip");
            clicked => {
                LibraryModals.scan-skip();
            }
        }
        if root.picking: HydraButton {
            text: T.tr("header.scan_games_ambiguous_confirm");
            enabled: !LibraryModals.scan-resolving && LibraryModals.scan-has-picks;
            clicked => {
                LibraryModals.scan-confirm-picks();
            }
        }
        if !root.picking: HydraButton {
            kind: "outline";
            text: LibraryModals.has-result ? T.tr("header.scan_games_close") : LibraryModals.scanning ? T.tr("header.scan_games_hide") : T.tr("header.scan_games_cancel");
            clicked => {
                LibraryModals.closing();
                LibraryModals.close-request += 1;
            }
        }
        if !root.picking && !LibraryModals.has-result && LibraryModals.scanning: HydraButton {
            kind: "danger";
            text: T.tr("header.scan_games_cancel_scan");
            clicked => {
                LibraryModals.scan-cancel();
            }
        }
        if !root.picking && !LibraryModals.has-result && !LibraryModals.scanning: HydraButton {
            text: T.tr("header.scan_games_start");
            enabled: !(root.manual && LibraryModals.scan-folders.length == 0);
            clicked => {
                LibraryModals.scan-start();
            }
        }
        if !root.picking && LibraryModals.has-result: HydraButton {
            text: T.tr("header.scan_games_scan_again");
            clicked => {
                LibraryModals.scan-again();
            }
        }
    }
}

export component LibraryModalsHost inherits Rectangle {
    property <int> close-request: LibraryModals.close-request;
    changed close-request => {
        controller.close();
    }
    property <bool> wanted: LibraryModals.kind != "";
    changed wanted => {
        if (self.wanted) {
            controller.open = true;
        }
    }
    controller := ModalController {
        closed => {
            LibraryModals.kind = "";
        }
    }

    if controller.mounted: Modal {
        width: root.width;
        height: root.height;
        title: LibraryModals.kind == "custom-game" ? T.tr("sidebar.custom_game_modal")
            : LibraryModals.kind == "classics-onboarding" ? T.tr("classics_onboarding.title")
            : T.tr("header.scan_games_title");
        description: LibraryModals.kind == "custom-game" ? T.tr("sidebar.custom_game_modal_description") : "";
        no-content-padding: LibraryModals.kind == "classics-onboarding";
        // clickOutsideToClose={!isScanning}
        click-outside-to-close: !(LibraryModals.kind == "scan" && LibraryModals.scanning);
        closing: controller.closing;
        blurred-page: LibraryModals.backdrop;
        request-close => {
            if (LibraryModals.kind == "custom-game" && LibraryModals.custom-adding) {
                return;
            }
            LibraryModals.closing();
            controller.close();
        }
        if LibraryModals.kind == "custom-game": CustomGameContent { }
        if LibraryModals.kind == "scan": ScanContent { }
        if LibraryModals.kind == "classics-onboarding": ClassicsOnboardingContent { }
    }
}
