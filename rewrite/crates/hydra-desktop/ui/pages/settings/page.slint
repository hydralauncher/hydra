// A labelled select-field section that saves on change.
component AccountSelect inherits Labeled {
    in property <string> key;
    in property <[SelectOption]> options;
    in property <string> value;
    in property <string> popup;
    in property <string> current-label;
    HorizontalLayout {
        alignment: start;
        SelectField {
            width: 124px;
            popup-id: root.popup;
            options: root.options;
            value: root.value;
            current-label: root.current-label;
            selected(value) => {
                SettingsData.account-select(root.key, value);
            }
        }
    }
}

// settings-account.tsx (settings-account__form: gap 16; sections gap 8)
component AccountPanel inherits VerticalLayout {
    spacing: 16px;
    AccountSelect {
        key: "profileVisibility";
        label: T.tr("settings.profile_visibility");
        options: SettingsData.visibility-options;
        value: SettingsData.profile-visibility;
        current-label: SettingsData.profile-visibility-label;
        popup: "settings-profile-visibility";
    }
    AccountSelect {
        key: "souvenirsVisibility";
        label: T.tr("settings.souvenirs_visibility");
        options: SettingsData.visibility-options;
        value: SettingsData.souvenirs-visibility;
        current-label: SettingsData.souvenirs-visibility-label;
        popup: "settings-souvenirs-visibility";
    }
    if SettingsData.show-screenshot-privacy: AccountSelect {
        key: "screenshotsVisibility";
        label: T.tr("screenshots.privacy_screenshots_visibility");
        options: SettingsData.visibility-options;
        value: SettingsData.screenshots-visibility;
        current-label: SettingsData.screenshots-visibility-label;
        popup: "settings-screenshots-visibility";
    }
    if SettingsData.show-comments-policy: AccountSelect {
        key: "screenshotCommentsPolicy";
        label: T.tr("screenshots.privacy_screenshot_comments_policy");
        options: SettingsData.comments-options;
        value: SettingsData.comments-policy;
        current-label: SettingsData.comments-policy-label;
        popup: "settings-comments-policy";
    }
    // username / email: h4 (14px bold) over p (20px line)
    VerticalLayout {
        spacing: 8px;
        Text {
            text: T.tr("settings.current_username");
            font-size: Theme.body-size;
            font-weight: 700;
            color: Theme.body;
        }
        Text {
            text: SettingsData.username;
            font-size: Theme.body-size;
            color: Theme.body;
            height: 20px;
            vertical-alignment: center;
        }
        Text {
            text: T.tr("settings.current_email");
            font-size: Theme.body-size;
            font-weight: 700;
            color: Theme.body;
        }
        Text {
            text: SettingsData.email != "" ? SettingsData.email : T.tr("settings.no_email_account");
            font-size: Theme.body-size;
            color: Theme.body;
            height: 20px;
            vertical-alignment: center;
        }
        // __actions: margin-top 8
        HorizontalLayout {
            padding-top: 8px;
            spacing: 8px;
            alignment: start;
            HydraButton {
                kind: "outline";
                icon: @image-url("../../icons/mail.svg");
                text: T.tr("settings.update_email");
                clicked => {
                    SettingsData.update-email();
                }
            }
            HydraButton {
                kind: "outline";
                icon: @image-url("../../icons/key.svg");
                text: T.tr("settings.update_password");
                clicked => {
                    SettingsData.update-password();
                }
            }
        }
    }
    VerticalLayout {
        spacing: 8px;
        GroupTitle {
            text: T.tr("settings.hydra_cloud");
        }
        // __subscription-info: small lines, gap 16
        VerticalLayout {
            spacing: 16px;
            for line in SettingsData.cloud-lines: Text {
                text: line;
                font-size: 11.67px;
                color: Theme.body;
            }
        }
        HorizontalLayout {
            alignment: start;
            HydraButton {
                kind: "outline";
                icon: Icons.cloud;
                text: SettingsData.cloud-action;
                clicked => {
                    SettingsData.open-checkout();
                }
            }
        }
    }
    VerticalLayout {
        spacing: 8px;
        GroupTitle {
            text: T.tr("settings.cloud_gifts");
        }
        CheckboxField {
            label: T.tr("settings.allow_cloud_gifts");
            checked: SettingsData.allow-gifts;
            enabled: !SettingsData.account-busy;
            toggled => {
                SettingsData.account-select("allowCloudGifts", SettingsData.allow-gifts ? "false" : "true");
            }
        }
    }
    VerticalLayout {
        spacing: 8px;
        GroupTitle {
            text: T.tr("settings.blocked_users");
        }
        if SettingsData.blocked.length == 0: Text {
            text: T.tr("settings.no_users_blocked");
            font-size: 11.67px;
            color: Theme.body;
        }
        for user in SettingsData.blocked: HorizontalLayout {
            spacing: 8px;
            // __user-avatar is grayscale (the image comes in gray)
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.background;
                clip: true;
                if user.avatar.width > 0: Image {
                    width: parent.width;
                    height: parent.height;
                    source: user.avatar;
                    image-fit: cover;
                }
                if user.avatar.width == 0: Icon {
                    width: 19px;
                    height: 19px;
                    source: Icons.person;
                    color: Theme.muted;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: user.name;
                font-size: Theme.body-size;
                color: Theme.body;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Icon {
                    width: 16px;
                    height: 16px;
                    source: @image-url("../../icons/x-circle-fill.svg");
                    color: Theme.danger;
                    opacity: SettingsData.unblocking ? Theme.disabled-opacity : 1;
                    TouchArea {
                        enabled: !SettingsData.unblocking;
                        mouse-cursor: pointer;
                        clicked => {
                            SettingsData.unblock(user.id);
                        }
                    }
                }
            }
        }
    }
}

// settings-download-sources.tsx
component SourcesPanel inherits VerticalLayout {
    property <bool> busy: SettingsData.sources-syncing || SettingsData.sources-removing;
    property <bool> empty: SettingsData.sources-loaded && SettingsData.sources.length == 0;
    spacing: 16px;
    Text {
        text: T.tr("settings.download_sources_description");
        font-size: Theme.body-size;
        color: Theme.body;
        wrap: word-wrap;
    }
    // settings-download-sources__header: space-between
    HorizontalLayout {
        spacing: 8px;
        HydraButton {
            kind: "outline";
            icon: @image-url("../../icons/sync.svg");
            text: T.tr("settings.sync_download_sources");
            enabled: !root.empty && !root.busy;
            clicked => {
                SettingsData.sync-sources();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        HydraButton {
            kind: "danger";
            icon: @image-url("../../icons/trash-16.svg");
            text: T.tr("settings.button_delete_all_sources");
            enabled: !root.empty && !root.busy;
            clicked => {
                SettingsData.remove-all-sources();
            }
        }
        HydraButton {
            kind: "outline";
            icon: Icons.plus-circle;
            text: T.tr("settings.add_download_source");
            enabled: !root.busy;
            clicked => {
                SettingsData.add-source();
            }
        }
    }
    // settings-download-sources__list: gap 16
    for source in SettingsData.sources: Rectangle {
        background: Theme.dark-background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        opacity: SettingsData.sources-syncing ? Theme.disabled-opacity : source.pending ? 0.6 : 1;
        animate opacity { duration: 200ms; easing: ease; }
        height: item.preferred-height + 2px;
        item := VerticalLayout {
            x: 1px;
            width: parent.width - 2px;
            padding: 16px;
            spacing: 8px;
            // __item-header (margin-bottom 8)
            VerticalLayout {
                padding-bottom: 8px;
                spacing: 8px;
                Text {
                    text: source.name;
                    font-size: 21px;
                    font-weight: 700;
                    color: Theme.body;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    Rectangle {
                        height: status.preferred-height + 10px;
                        width: status-row.preferred-width + 18px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.2);
                        background: rgba(255, 255, 255, 0.1);
                        status-row := HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            if source.pending: VerticalLayout {
                                alignment: center;
                                Icon {
                                    width: 12px;
                                    height: 12px;
                                    source: @image-url("../../icons/sync-12.svg");
                                    color: Theme.muted;
                                    transform-rotation: Math.mod(animation-tick() / 1000ms, 1) * 360deg;
                                }
                            }
                            status := Text {
                                text: source.status-label;
                                font-size: Theme.tiny-size;
                                font-weight: 700;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // __navigate-button: underlined <small>
                HorizontalLayout {
                    alignment: start;
                    count := Text {
                        text: source.count-label;
                        font-size: 11.67px;
                        color: Theme.muted;
                        Rectangle {
                            y: parent.height - 2px;
                            height: 1px;
                            width: parent.width;
                            background: Theme.muted;
                            visible: source.fingerprint != "";
                        }
                        TouchArea {
                            mouse-cursor: source.fingerprint != "" ? MouseCursor.pointer : MouseCursor.default;
                            clicked => {
                                if (source.fingerprint != "") {
                                    SettingsData.open-source-in-catalogue(source.fingerprint);
                                }
                            }
                        }
                    }
                }
            }
            Labeled {
                label: T.tr("settings.download_source_url");
                HorizontalLayout {
                    spacing: 8px;
                    TextField {
                        text: source.url;
                        read-only: true;
                    }
                    HydraButton {
                        kind: "outline";
                        icon: @image-url("../../icons/no-entry.svg");
                        text: T.tr("settings.remove_download_source");
                        enabled: !SettingsData.sources-removing;
                        clicked => {
                            SettingsData.remove-source(source.id);
                        }
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    // ---- panel scrolling (overflow: auto), with the wheel tween
    property <length> max-scroll: Math.max(0, panel.content-height - panel.height);
    property <length> scroll-y;
    property <ScrollTween> tween;
    function wheel-by(dy: length) {
        if (SmoothScroll.lines) {
            root.tween = SmoothScroll.towards(root.tween, animation-tick(), root.scroll-y, dy * SmoothScroll.wheel-scale, -root.max-scroll, 0);
            root.scroll-y = root.tween.to;
        } else {
            root.tween.active = false;
            root.scroll-y = Math.clamp(root.scroll-y + dy * SmoothScroll.wheel-scale, -root.max-scroll, 0);
        }
    }
    changed scroll-y => {
        if (root.tween.active && root.scroll-y != root.tween.to) {
            root.tween.active = false;
        }
    }
    Timer {
        interval: 16ms;
        running: root.tween.active;
        triggered => {
            if (!SmoothScroll.running(root.tween, animation-tick())) {
                root.tween.active = false;
            }
        }
    }
    property <string> category: SettingsData.category;
    changed category => {
        root.tween.active = false;
        root.scroll-y = 0;
    }

    // settings__container: padding 24px, inside .container__content's 9px
    // scrollbar gutter (scrollbar-gutter: stable)
    box := Rectangle {
        x: 24px;
        y: 24px;
        width: root.width - 48px - 9px;
        height: root.height - 48px;
        background: Theme.background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 10px;
        drop-shadow-color: rgba(0, 0, 0, 0.7);
        clip: true;

        HorizontalLayout {
            padding: 1px;
            // ---- settings__sidebar: max-content width, 220..320px
            Rectangle {
                width: Math.clamp(sidebar.preferred-width, 220px, 320px);
                background: Theme.dark-background;
                sidebar := VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    for category in SettingsData.categories: VerticalLayout {
                        spacing: 8px;
                        // settings__sidebar-group: divider (margin-bottom 4) + label, padding-top 8
                        if category.group-start: VerticalLayout {
                            padding-top: 8px;
                            spacing: 8px;
                            Rectangle {
                                height: 5px;
                                Rectangle {
                                    y: 0;
                                    height: 1px;
                                    background: rgba(255, 255, 255, 0.06);
                                }
                            }
                            Text {
                                text: category.group == "classics" ? T.tr("settings.classics_group") : category.group;
                                font-size: Theme.tiny-size;
                                font-weight: 600;
                                color: Theme.subtle;
                                letter-spacing: 0.8px;
                                x: 12px;
                            }
                        }
                        SidebarButton {
                            category: category;
                            active: SettingsData.category == category.id;
                            clicked => {
                                SettingsData.select-category(category.id);
                            }
                        }
                    }
                }
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.border;
                }
            }

            // ---- settings__panel: padding 20px, gap 20px, overflow auto
            Rectangle {
                horizontal-stretch: 1;
                panel := Flickable {
                    width: parent.width;
                    height: parent.height;
                    interactive: false;
                    viewport-height: column.preferred-height;
                    viewport-y: root.tween.active ? SmoothScroll.value(root.tween, animation-tick()) : root.scroll-y;
                    TouchArea {
                        width: panel.width;
                        height: column.preferred-height;
                        scroll-event(event) => {
                            root.wheel-by(event.delta-y);
                            accept
                        }
                        column := VerticalLayout {
                            width: panel.width;
                            padding: 20px;
                            spacing: 20px;
                            alignment: start;
                            if SettingsData.category != "emulation": Text {
                                text: SettingsData.category-label;
                                font-size: 21px;
                                font-weight: 700;
                                color: Theme.body;
                                height: 28px;
                                vertical-alignment: center;
                            }
                            if SettingsData.category == "general": GeneralPanel { }
                            if SettingsData.category == "downloads": DownloadsPanel { }
                            if SettingsData.category == "download_sources": SourcesPanel { }
                            if SettingsData.category == "notifications": NotificationsPanel { }
                            if SettingsData.category == "content_gameplay": ContentPanel { }
                            if SettingsData.category == "account_privacy" && SettingsData.account-loaded: AccountPanel { }
                            if SettingsData.category == "integrations": IntegrationsPanel { }
                            if SettingsData.category != "general" && SettingsData.category != "downloads" && SettingsData.category != "download_sources" && SettingsData.category != "notifications" && SettingsData.category != "content_gameplay" && SettingsData.category != "account_privacy" && SettingsData.category != "integrations": Text {
                                text: "TODO(settings): " + SettingsData.category + " not ported yet";
                                color: Theme.subtle;
                                font-size: Theme.small-size;
                            }
                        }
                    }
                }
                if root.max-scroll > 0: ScrollBar {
                    x: parent.width - self.width;
                    height: parent.height;
                    content-height: panel.viewport-height;
                    viewport-height: panel.height;
                    content-y <=> root.scroll-y;
                    shown-offset: -panel.viewport-y;
                }
            }
        }
    }

}
