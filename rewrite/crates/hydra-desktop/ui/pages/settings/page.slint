// pages/settings/settings.tsx (settings.scss): a bordered box with the
// category sidebar and the panel. Rust fills `SettingsData` (settings_page.rs).
import { Theme, Icons } from "../../theme.slint";
import { Icon, HydraButton, ScrollBar } from "../../components/widgets.slint";
import { TextField, CheckboxField, SelectField, SelectOption } from "../../components/fields.slint";
import { SmoothScroll, ScrollTween } from "../../components/smooth-scroll.slint";
import { T } from "../../globals.slint";

export struct SettingsCategory {
    id: string,
    label: string,
    // "" or "classics": a divider and group label before the first of a group
    group: string,
    group-start: bool,
}

// One download source (settings-download-sources__item).
export struct SourceCard {
    id: string,
    name: string,
    url: string,
    status-label: string,
    // PENDING_MATCHING / MATCHING
    pending: bool,
    // "23,927 download options" or "No information yet"
    count-label: string,
    fingerprint: string,
}

export global SettingsData {
    in property <[SettingsCategory]> categories;
    in property <string> category: "general";
    // the h2 above the panel
    in property <string> category-label;

    // ---- General
    in property <string> downloads-path;
    in property <[SelectOption]> language-options;
    in property <string> language;
    in property <string> language-label;
    in property <bool> show-run-at-startup: true;
    in property <bool> linux;
    in property <bool> prefer-quit;
    in property <bool> hide-to-tray;
    in property <bool> run-at-startup;
    in property <bool> start-minimized;
    in property <bool> launch-to-library;
    in property <bool> open-friends;
    in property <bool> enable-auto-install;
    in property <bool> native-decorations;

    // ---- Downloads
    in-out property <string> max-speed;
    in property <string> max-speed-label;
    in property <string> max-speed-hint;
    in property <[SelectOption]> network-options;
    in property <string> network-interface;
    in property <string> network-label;
    // the longest option, for the native select's max-content width
    in property <string> network-longest;
    in property <bool> seed-after;
    in property <bool> extract-by-default;
    in property <bool> speed-in-megabytes;
    in property <bool> delete-archives;
    in property <bool> show-shortcuts: true;
    in property <bool> create-shortcuts;
    in property <bool> append-trackers;
    in-out property <string> manual-trackers;
    in property <bool> append-trackers-url;
    in-out property <string> trackers-url;
    in property <string> trackers-error;
    // ---- Download sources
    in property <[SourceCard]> sources;
    in property <bool> sources-loaded;
    in property <bool> sources-syncing;
    in property <bool> sources-removing;
    callback sync-sources();
    callback remove-all-sources();
    callback add-source();
    callback remove-source(string);
    callback open-source-in-catalogue(string);

    callback max-speed-committed();
    callback network-selected(string);
    callback trackers-edited();
    callback trackers-url-committed();

    callback select-category(string);
    callback change-downloads-path();
    callback language-selected(string);
    // A checkbox by its preference key (e.g. "preferQuitInsteadOfHiding").
    callback toggle(string);
}

// settings__sidebar-button: padding 8px 12px, radius 4px, line-height 1.2
component SidebarButton inherits Rectangle {
    in property <SettingsCategory> category;
    in property <bool> active;
    callback clicked();
    height: 14px * 1.2 + 16px;
    border-radius: 4px;
    background: touch.has-hover ? rgba(255, 255, 255, 0.15) : root.active ? rgba(255, 255, 255, 0.1) : transparent;
    animate background { duration: 100ms; easing: ease; }
    // white-space: nowrap -> the sidebar is as wide as its longest label
    preferred-width: row.preferred-width;
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Icon {
                width: 16px;
                height: 16px;
                opacity: 0.9;
                color: Theme.muted;
                source: root.category.id == "general" ? Icons.gear
                    : root.category.id == "downloads" ? Icons.download
                    : root.category.id == "download_sources" ? @image-url("../../icons/link.svg")
                    : root.category.id == "notifications" ? Icons.bell
                    : root.category.id == "content_gameplay" ? Icons.play
                    : root.category.id == "screenshots" ? @image-url("../../icons/camera.svg")
                    : root.category.id == "integrations" ? Icons.cloud
                    : root.category.id == "compatibility" ? Icons.wrench
                    : root.category.id == "account_privacy" ? @image-url("../../icons/shield-check.svg")
                    : @image-url("../../icons/gamepad-2.svg");
            }
        }
        Text {
            text: root.category.label;
            color: Theme.muted;
            font-size: Theme.body-size;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// h3 (16.38px bold) inside settings-context-panel__group
component GroupTitle inherits Text {
    font-size: 16.38px;
    font-weight: 700;
    color: Theme.body;
    height: 22px;
    vertical-alignment: center;
}

// text-field / select-field with a label above (gap 8px)
component Labeled inherits VerticalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        font-size: Theme.body-size;
        color: Theme.body;
        height: 19px;
        vertical-alignment: center;
    }
    @children
}

component Check inherits CheckboxField {
    in property <string> key;
    toggled => {
        SettingsData.toggle(self.key);
    }
}

// settings-context-general.tsx (the Appearance/themes group is not ported:
// the theme editor was removed from the rewrite).
component GeneralPanel inherits VerticalLayout {
    spacing: 16px;
    // settings-context-panel__group: padding-top 12px, gap 12px
    VerticalLayout {
        padding-top: 12px;
        spacing: 12px;
        GroupTitle {
            text: T.tr("settings.app_basics");
        }
        Labeled {
            label: T.tr("settings.downloads_path");
            HorizontalLayout {
                spacing: 8px;
                TextField {
                    text: SettingsData.downloads-path;
                    read-only: true;
                }
                HydraButton {
                    kind: "outline";
                    text: T.tr("settings.change");
                    clicked => {
                        SettingsData.change-downloads-path();
                    }
                }
            }
        }
        Labeled {
            label: T.tr("settings.language");
            HorizontalLayout {
                alignment: start;
                SelectField {
                    // a native <select> as wide as its longest option (180px in Electron)
                    width: 180px;
                    popup-id: "settings-language";
                    options: SettingsData.language-options;
                    value: SettingsData.language;
                    current-label: SettingsData.language-label;
                    selected(value) => {
                        SettingsData.language-selected(value);
                    }
                }
            }
        }
    }
    VerticalLayout {
        padding-top: 12px;
        spacing: 12px;
        GroupTitle {
            text: T.tr("settings.startup_behavior");
        }
        Check {
            key: "preferQuitInsteadOfHiding";
            label: T.tr("settings.quit_app_instead_hiding");
            checked: SettingsData.prefer-quit;
        }
        Check {
            key: "hideToTrayOnGameStart";
            label: T.tr("settings.hide_to_tray_on_game_start");
            checked: SettingsData.hide-to-tray;
        }
        if SettingsData.show-run-at-startup: Check {
            key: "runAtStartup";
            label: T.tr("settings.launch_with_system");
            checked: SettingsData.run-at-startup;
        }
        if SettingsData.show-run-at-startup: Check {
            key: "startMinimized";
            label: T.tr("settings.launch_minimized");
            checked: SettingsData.run-at-startup && SettingsData.start-minimized;
            enabled: SettingsData.run-at-startup;
        }
        Check {
            key: "launchToLibraryPage";
            label: T.tr("settings.launch_hydra_in_library_page");
            checked: SettingsData.launch-to-library;
        }
        Check {
            key: "openFriendsWindowOnStartup";
            label: T.tr("settings.open_friends_window_on_startup");
            checked: SettingsData.open-friends;
        }
    }
    if SettingsData.linux: VerticalLayout {
        padding-top: 12px;
        spacing: 12px;
        GroupTitle {
            text: T.tr("settings.behavior");
        }
        Check {
            key: "enableAutoInstall";
            label: T.tr("settings.enable_auto_install");
            checked: SettingsData.enable-auto-install;
        }
        Check {
            key: "useNativeWindowDecorations";
            label: T.tr("settings.use_native_window_decorations") + " " + T.tr("settings.use_native_window_decorations_hint");
            checked: SettingsData.native-decorations;
        }
    }
}

// settings-global-trackers__textarea / __url-input: dark, 1px border,
// radius 8, padding 12, monospace 12px with line-height 1.5
component MonoField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> multi-line;
    in property <bool> enabled: true;
    in-out property <string> text;
    callback edited();
    callback focus-lost();
    height: root.multi-line ? 5 * 18px + 24px + 2px : 18px + 24px + 2px;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? #dadbe1 : Theme.border;
    background: Theme.dark-background;
    TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.text : MouseCursor.default;
        clicked => {
            input.focus();
        }
    }
    Text {
        x: 13px;
        y: 13px;
        width: parent.width - 26px;
        text: root.placeholder;
        visible: input.text == "";
        color: rgba(255, 255, 255, 0.4);
        font-family: "Cascadia Code";
        font-size: Theme.small-size;
        wrap: word-wrap;
    }
    input := TextInput {
        x: 13px;
        y: 13px;
        width: parent.width - 26px;
        height: parent.height - 26px;
        text <=> root.text;
        enabled: root.enabled;
        single-line: !root.multi-line;
        wrap: root.multi-line ? word-wrap : no-wrap;
        color: #dadbe1;
        font-family: "Cascadia Code";
        font-size: Theme.small-size;
        edited => {
            root.edited();
        }
        changed has-focus => {
            if (!self.has-focus) {
                root.focus-lost();
            }
        }
    }
}

// settings-context-downloads.tsx
component DownloadsPanel inherits VerticalLayout {
    spacing: 16px;
    VerticalLayout {
        padding-top: 12px;
        spacing: 12px;
        GroupTitle {
            text: T.tr("settings.download_behavior");
        }
        // text-field with a label and a <small> hint
        VerticalLayout {
            spacing: 8px;
            Text {
                text: SettingsData.max-speed-label;
                font-size: Theme.body-size;
                color: Theme.body;
            }
            TextField {
                placeholder: T.tr("settings.max_download_speed_unlimited");
                text <=> SettingsData.max-speed;
                focus-lost => {
                    SettingsData.max-speed-committed();
                }
            }
            Text {
                text: SettingsData.max-speed-hint;
                font-size: 11.67px;
                color: Theme.body;
            }
        }
        // settings-general__network-interface: gap 8, margin-block 16
        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 8px;
            Text {
                text: T.tr("settings.network_interface");
                font-size: Theme.body-size;
                color: Theme.body;
            }
            Rectangle {
                height: 40px;
                // the select's max-content width
                network-measure := Text {
                    visible: false;
                    text: SettingsData.network-longest;
                    font-size: Theme.body-size;
                }
                SelectField {
                    x: 0;
                    width: Math.max(180px, network-measure.preferred-width + 54px);
                    popup-id: "settings-network";
                    options: SettingsData.network-options;
                    value: SettingsData.network-interface;
                    current-label: SettingsData.network-label;
                    selected(value) => {
                        SettingsData.network-selected(value);
                    }
                }
            }
            Text {
                text: T.tr("settings.network_interface_hint");
                font-size: 13px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
        Check {
            key: "seedAfterDownloadComplete";
            label: T.tr("settings.seed_after_download_complete");
            checked: SettingsData.seed-after;
        }
        Check {
            key: "extractFilesByDefault";
            label: T.tr("settings.extract_files_by_default");
            checked: SettingsData.extract-by-default;
        }
        Check {
            key: "showDownloadSpeedInMegabytes";
            label: T.tr("settings.show_download_speed_in_megabytes");
            checked: SettingsData.speed-in-megabytes;
        }
        Check {
            key: "deleteArchiveFilesAfterExtractionByDefault";
            label: T.tr("settings.delete_archive_files_after_extraction");
            checked: SettingsData.delete-archives;
        }
        if SettingsData.show-shortcuts: Check {
            key: "createStartMenuShortcut";
            label: T.tr("settings.create_shortcuts_on_download");
            checked: SettingsData.create-shortcuts;
        }
    }
    VerticalLayout {
        padding-top: 12px;
        spacing: 12px;
        GroupTitle {
            text: T.tr("settings.global_trackers");
        }
        // settings-global-trackers: gap 16
        VerticalLayout {
            spacing: 16px;
            Text {
                text: T.tr("settings.global_trackers_description");
                font-size: Theme.small-size;
                color: Theme.body;
                wrap: word-wrap;
            }
            if SettingsData.trackers-error != "": Text {
                text: SettingsData.trackers-error;
                font-size: Theme.small-size;
                color: Theme.error;
            }
            VerticalLayout {
                spacing: 8px;
                Check {
                    key: "appendGlobalTrackers";
                    label: T.tr("settings.global_trackers_append_manual");
                    checked: SettingsData.append-trackers;
                }
                MonoField {
                    multi-line: true;
                    opacity: SettingsData.append-trackers ? 1 : 0.5;
                    enabled: SettingsData.append-trackers;
                    placeholder: T.tr("settings.global_trackers_manual_placeholder");
                    text <=> SettingsData.manual-trackers;
                    edited => {
                        SettingsData.trackers-edited();
                    }
                }
            }
            VerticalLayout {
                spacing: 8px;
                Check {
                    key: "appendGlobalTrackersUrl";
                    label: T.tr("settings.global_trackers_append_url");
                    checked: SettingsData.append-trackers-url;
                }
                MonoField {
                    opacity: SettingsData.append-trackers-url ? 1 : 0.5;
                    enabled: SettingsData.append-trackers-url;
                    placeholder: T.tr("settings.global_trackers_url_placeholder");
                    text <=> SettingsData.trackers-url;
                    edited => {
                        SettingsData.trackers-edited();
                    }
                    focus-lost => {
                        SettingsData.trackers-url-committed();
                    }
                }
            }
        }
    }
}

// settings-download-sources.tsx
component SourcesPanel inherits VerticalLayout {
    property <bool> busy: SettingsData.sources-syncing || SettingsData.sources-removing;
    property <bool> empty: SettingsData.sources-loaded && SettingsData.sources.length == 0;
    spacing: 16px;
    Text {
        text: T.tr("settings.download_sources_description");
        font-size: Theme.body-size;
        color: Theme.body;
        wrap: word-wrap;
    }
    // settings-download-sources__header: space-between
    HorizontalLayout {
        spacing: 8px;
        HydraButton {
            kind: "outline";
            icon: @image-url("../../icons/sync.svg");
            text: T.tr("settings.sync_download_sources");
            enabled: !root.empty && !root.busy;
            clicked => {
                SettingsData.sync-sources();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        HydraButton {
            kind: "danger";
            icon: @image-url("../../icons/trash-16.svg");
            text: T.tr("settings.button_delete_all_sources");
            enabled: !root.empty && !root.busy;
            clicked => {
                SettingsData.remove-all-sources();
            }
        }
        HydraButton {
            kind: "outline";
            icon: Icons.plus-circle;
            text: T.tr("settings.add_download_source");
            enabled: !root.busy;
            clicked => {
                SettingsData.add-source();
            }
        }
    }
    // settings-download-sources__list: gap 16
    for source in SettingsData.sources: Rectangle {
        background: Theme.dark-background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        opacity: SettingsData.sources-syncing ? Theme.disabled-opacity : source.pending ? 0.6 : 1;
        animate opacity { duration: 200ms; easing: ease; }
        height: item.preferred-height + 2px;
        item := VerticalLayout {
            x: 1px;
            width: parent.width - 2px;
            padding: 16px;
            spacing: 8px;
            // __item-header (margin-bottom 8)
            VerticalLayout {
                padding-bottom: 8px;
                spacing: 8px;
                Text {
                    text: source.name;
                    font-size: 21px;
                    font-weight: 700;
                    color: Theme.body;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    Rectangle {
                        height: status.preferred-height + 10px;
                        width: status-row.preferred-width + 18px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.2);
                        background: rgba(255, 255, 255, 0.1);
                        status-row := HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            if source.pending: VerticalLayout {
                                alignment: center;
                                Icon {
                                    width: 12px;
                                    height: 12px;
                                    source: @image-url("../../icons/sync-12.svg");
                                    color: Theme.muted;
                                    transform-rotation: Math.mod(animation-tick() / 1000ms, 1) * 360deg;
                                }
                            }
                            status := Text {
                                text: source.status-label;
                                font-size: Theme.tiny-size;
                                font-weight: 700;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // __navigate-button: underlined <small>
                HorizontalLayout {
                    alignment: start;
                    count := Text {
                        text: source.count-label;
                        font-size: 11.67px;
                        color: Theme.muted;
                        Rectangle {
                            y: parent.height - 2px;
                            height: 1px;
                            width: parent.width;
                            background: Theme.muted;
                            visible: source.fingerprint != "";
                        }
                        TouchArea {
                            mouse-cursor: source.fingerprint != "" ? MouseCursor.pointer : MouseCursor.default;
                            clicked => {
                                if (source.fingerprint != "") {
                                    SettingsData.open-source-in-catalogue(source.fingerprint);
                                }
                            }
                        }
                    }
                }
            }
            Labeled {
                label: T.tr("settings.download_source_url");
                HorizontalLayout {
                    spacing: 8px;
                    TextField {
                        text: source.url;
                        read-only: true;
                    }
                    HydraButton {
                        kind: "outline";
                        icon: @image-url("../../icons/no-entry.svg");
                        text: T.tr("settings.remove_download_source");
                        enabled: !SettingsData.sources-removing;
                        clicked => {
                            SettingsData.remove-source(source.id);
                        }
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    // ---- panel scrolling (overflow: auto), with the wheel tween
    property <length> max-scroll: Math.max(0, panel.content-height - panel.height);
    property <length> scroll-y;
    property <ScrollTween> tween;
    function wheel-by(dy: length) {
        if (SmoothScroll.lines) {
            root.tween = SmoothScroll.towards(root.tween, animation-tick(), root.scroll-y, dy * SmoothScroll.wheel-scale, -root.max-scroll, 0);
            root.scroll-y = root.tween.to;
        } else {
            root.tween.active = false;
            root.scroll-y = Math.clamp(root.scroll-y + dy * SmoothScroll.wheel-scale, -root.max-scroll, 0);
        }
    }
    changed scroll-y => {
        if (root.tween.active && root.scroll-y != root.tween.to) {
            root.tween.active = false;
        }
    }
    Timer {
        interval: 16ms;
        running: root.tween.active;
        triggered => {
            if (!SmoothScroll.running(root.tween, animation-tick())) {
                root.tween.active = false;
            }
        }
    }
    property <string> category: SettingsData.category;
    changed category => {
        root.tween.active = false;
        root.scroll-y = 0;
    }

    // settings__container: padding 24px, inside .container__content's 9px
    // scrollbar gutter (scrollbar-gutter: stable)
    box := Rectangle {
        x: 24px;
        y: 24px;
        width: root.width - 48px - 9px;
        height: root.height - 48px;
        background: Theme.background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 10px;
        drop-shadow-color: rgba(0, 0, 0, 0.7);
        clip: true;

        HorizontalLayout {
            padding: 1px;
            // ---- settings__sidebar: max-content width, 220..320px
            Rectangle {
                width: Math.clamp(sidebar.preferred-width, 220px, 320px);
                background: Theme.dark-background;
                sidebar := VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    for category in SettingsData.categories: VerticalLayout {
                        spacing: 8px;
                        // settings__sidebar-group: divider (margin-bottom 4) + label, padding-top 8
                        if category.group-start: VerticalLayout {
                            padding-top: 8px;
                            spacing: 8px;
                            Rectangle {
                                height: 5px;
                                Rectangle {
                                    y: 0;
                                    height: 1px;
                                    background: rgba(255, 255, 255, 0.06);
                                }
                            }
                            Text {
                                text: category.group == "classics" ? T.tr("settings.classics_group") : category.group;
                                font-size: Theme.tiny-size;
                                font-weight: 600;
                                color: Theme.subtle;
                                letter-spacing: 0.8px;
                                x: 12px;
                            }
                        }
                        SidebarButton {
                            category: category;
                            active: SettingsData.category == category.id;
                            clicked => {
                                SettingsData.select-category(category.id);
                            }
                        }
                    }
                }
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.border;
                }
            }

            // ---- settings__panel: padding 20px, gap 20px, overflow auto
            Rectangle {
                horizontal-stretch: 1;
                panel := Flickable {
                    width: parent.width;
                    height: parent.height;
                    interactive: false;
                    viewport-height: column.preferred-height;
                    viewport-y: root.tween.active ? SmoothScroll.value(root.tween, animation-tick()) : root.scroll-y;
                    TouchArea {
                        width: panel.width;
                        height: column.preferred-height;
                        scroll-event(event) => {
                            root.wheel-by(event.delta-y);
                            accept
                        }
                        column := VerticalLayout {
                            width: panel.width;
                            padding: 20px;
                            spacing: 20px;
                            alignment: start;
                            if SettingsData.category != "emulation": Text {
                                text: SettingsData.category-label;
                                font-size: 21px;
                                font-weight: 700;
                                color: Theme.body;
                                height: 28px;
                                vertical-alignment: center;
                            }
                            if SettingsData.category == "general": GeneralPanel { }
                            if SettingsData.category == "downloads": DownloadsPanel { }
                            if SettingsData.category == "download_sources": SourcesPanel { }
                            if SettingsData.category != "general" && SettingsData.category != "downloads" && SettingsData.category != "download_sources": Text {
                                text: "TODO(settings): " + SettingsData.category + " not ported yet";
                                color: Theme.subtle;
                                font-size: Theme.small-size;
                            }
                        }
                    }
                }
                if root.max-scroll > 0: ScrollBar {
                    x: parent.width - self.width;
                    height: parent.height;
                    content-height: panel.viewport-height;
                    viewport-height: panel.height;
                    content-y <=> root.scroll-y;
                    shown-offset: -panel.viewport-y;
                }
            }
        }
    }

}
