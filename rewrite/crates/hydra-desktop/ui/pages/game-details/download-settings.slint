// modals/download-settings-modal.{tsx,scss}: the downloader list, the
// download path, the extraction checkboxes and "Download now".
import { Theme, Tip, Ids } from "../../theme.slint";
import { Icon, HydraButton, Spinner } from "../../components/widgets.slint";
import { CheckboxField } from "../../components/fields.slint";
import { T } from "../../globals.slint";

export struct DownloaderRow {
    // Downloader enum value
    kind: int,
    name: string,
    // 0 available, 1 offline, 2 available but not configured
    state: int,
    // "recommended" (Real-Debrid), "hydra-cloud" (VikingFile without a subscription) or ""
    badge: string,
    // tooltip of the availability dot
    tooltip: string,
}

export global DownloadSettings {
    in-out property <bool> open;
    in property <[DownloaderRow]> downloaders;
    in property <int> selected: -1;
    in property <string> path;
    // "901.9 GB left on disk", empty until known
    in property <string> free-space;
    // not enough space / no write permission (the latter opens an article)
    in property <string> path-error;
    in property <bool> path-error-link;
    in-out property <bool> extract: true;
    in-out property <bool> delete-archives: true;
    in property <bool> starting;
    in property <bool> has-active-download;
    in property <bool> can-start;
    callback select(int);
    callback change-path();
    callback start();
    callback open-settings();
    callback open-path-error();
    callback closed();
}

// __downloader-item: 48px, padding 12px 16px, border-bottom, hover 0.05 / selected 0.08
component DownloaderItem inherits Rectangle {
    in property <DownloaderRow> option;
    in property <bool> selected;
    in property <bool> last;
    property <bool> disabled: root.option.state == 1;
    property <int> tip-id;
    init => {
        self.tip-id = Ids.take();
    }
    height: 48px;
    background: root.selected ? rgba(255, 255, 255, 0.08) : touch.has-hover && !root.disabled ? rgba(255, 255, 255, 0.05) : transparent;
    animate background { duration: 150ms; easing: ease; }

    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 17px;
        padding-right: 17px;
        spacing: 8px;
        Text {
            text: root.option.name;
            font-size: Theme.body-size;
            color: Theme.body;
            vertical-alignment: center;
            opacity: root.disabled ? 0.5 : 1;
        }
        // __availability-indicator (the available one pulses: scale 1.1, opacity 0.7, 2s)
        VerticalLayout {
            alignment: center;
            opacity: root.disabled ? 0.5 : 1;
            dot := Rectangle {
                property <float> phase: root.option.state == 0 ? (1 - Math.cos(Math.mod(animation-tick() / 1ms, 2000) / 2000 * 360deg)) / 2 : 0;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.option.state == 0 ? Theme.success : root.option.state == 2 ? Theme.warning : Theme.error;
                drop-shadow-blur: 6px;
                drop-shadow-color: root.option.state == 0 ? rgba(28, 151, 73, 0.5) : root.option.state == 2 ? rgba(255, 193, 7, 0.5) : rgba(225, 29, 72, 0.5);
                transform-scale: 1 + 0.1 * self.phase;
                opacity: 1 - 0.3 * self.phase;
                dot-touch := TouchArea {
                    changed has-hover => {
                        if (self.has-hover) {
                            Tip.show(root.tip-id, root.option.tooltip, dot.absolute-position.x, dot.absolute-position.y, 8px, 8px, "top");
                        } else {
                            Tip.hide(root.tip-id);
                        }
                    }
                    clicked => {
                        touch.clicked();
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        // __check-icon-wrapper: spring scale-in (stiffness 300, damping 20)
        if root.selected: Rectangle {
            width: 20px;
            property <bool> shown;
            Icon {
                width: 16px;
                height: 16px;
                source: @image-url("../../icons/check-circle-fill.svg");
                color: #ffffff;
                transform-scale: parent.shown ? 1 : 0;
                animate transform-scale { duration: 450ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            }
            Timer {
                interval: 1ms;
                running: !parent.shown;
                triggered => {
                    parent.shown = true;
                }
            }
        }
        if !root.selected && root.option.badge == "recommended": VerticalLayout {
            alignment: center;
            // .badge here: 2px 8px, 11px, 16px tall
            Rectangle {
                height: 16px;
                width: rec-text.preferred-width + 16px + 2px;
                border-radius: 6px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.2);
                background: rgba(255, 255, 255, 0.1);
                rec-text := Text {
                    text: T.tr("game_details.recommended");
                    font-size: Theme.tiny-size;
                    color: Theme.muted;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
        if !root.selected && root.option.badge == "hydra-cloud": VerticalLayout {
            alignment: center;
            Rectangle {
                height: cloud-text.preferred-height;
                width: cloud-text.preferred-width + 16px;
                border-radius: 4px;
                background: @linear-gradient(270deg, #0d8f8f 50%, #0f5ea8 100%);
                cloud-text := Text {
                    text: "Hydra Cloud";
                    color: #ffffff;
                    font-size: Theme.small-size;
                }
            }
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => {
            DownloadSettings.select(root.option.kind);
        }
    }
}

export component DownloadSettingsBody inherits VerticalLayout {
    spacing: 24px;

    // Downloader
    VerticalLayout {
        spacing: 8px;
        Text {
            text: T.tr("game_details.downloader");
            font-size: Theme.body-size;
            color: Theme.body;
        }
        // __downloaders-list-wrapper: border, dark background, at most 200px
        Rectangle {
            height: Math.min(200px, DownloadSettings.downloaders.length * 48px) + 2px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.dark-background;
            Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                viewport-height: DownloadSettings.downloaders.length * 48px;
                for row[i] in DownloadSettings.downloaders: DownloaderItem {
                    y: i * 48px;
                    width: parent.width;
                    option: row;
                    selected: DownloadSettings.selected == row.kind;
                    last: i == DownloadSettings.downloaders.length - 1;
                }
            }
        }
    }

    // Download path: label, read-only field + "Change", error, hint
    VerticalLayout {
        spacing: 8px;
        VerticalLayout {
            spacing: 8px;
            Text {
                text: T.tr("game_details.download_path");
                font-size: Theme.body-size;
                color: Theme.body;
            }
            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: DownloadSettings.path-error != "" ? Theme.danger : field-touch.has-hover ? rgba(255, 255, 255, 0.5) : Theme.border;
                    animate border-color { duration: 200ms; easing: ease; }
                    background: Theme.dark-background;
                    clip: true;
                    field-touch := TouchArea { }
                    Text {
                        x: 9px;
                        width: parent.width - 18px;
                        text: DownloadSettings.path;
                        font-size: 13.33px;
                        color: #dadbe1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                HydraButton {
                    kind: "outline";
                    text: T.tr("game_details.change");
                    enabled: !DownloadSettings.starting;
                    clicked => {
                        DownloadSettings.change-path();
                    }
                }
            }
            if DownloadSettings.path-error != "": Text {
                text: DownloadSettings.path-error;
                font-size: 11.67px;
                color: Theme.error;
                wrap: word-wrap;
                error-touch := TouchArea {
                    enabled: DownloadSettings.path-error-link;
                    mouse-cursor: DownloadSettings.path-error-link ? pointer : default;
                    clicked => {
                        DownloadSettings.open-path-error();
                    }
                }
            }
        }
        // select_folder_hint: "To change the default folder, go to the <0>Settings</0>"
        HorizontalLayout {
            alignment: start;
            Text {
                text: T.tr-parts("game_details.select_folder_hint", 0);
                font-size: Theme.small-size;
                color: Theme.body;
            }
            Text {
                text: T.tr-parts("game_details.select_folder_hint", 1);
                font-size: Theme.small-size;
                color: #c0c1c7;
                link-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        DownloadSettings.open-settings();
                    }
                }
                Rectangle {
                    visible: link-touch.has-hover;
                    y: parent.height - 3px;
                    height: 1px;
                    background: #c0c1c7;
                }
            }
            Text {
                text: T.tr-parts("game_details.select_folder_hint", 2);
                font-size: Theme.small-size;
                color: Theme.body;
            }
        }
    }

    CheckboxField {
        label: T.tr("game_details.automatically_extract_downloaded_files");
        checked: DownloadSettings.extract;
        toggled => {
            DownloadSettings.extract = !DownloadSettings.extract;
        }
    }
    CheckboxField {
        label: T.tr("game_details.delete_archive_files_after_extraction");
        checked: DownloadSettings.delete-archives;
        toggled => {
            DownloadSettings.delete-archives = !DownloadSettings.delete-archives;
        }
    }

    // getButtonContent(): Loading (spinner) / Add to queue / Download now
    HydraButton {
        kind: "primary";
        horizontal-stretch: 1;
        enabled: DownloadSettings.can-start;
        icon: DownloadSettings.starting ? @image-url("../../icons/sync.svg") : DownloadSettings.has-active-download ? @image-url("../../icons/plus.svg") : @image-url("../../icons/download.svg");
        icon-rotation: DownloadSettings.starting ? Math.mod(animation-tick() / 1ms, 1000) / 1000 * 360deg : 0deg;
        text: DownloadSettings.starting ? T.tr("game_details.loading") : DownloadSettings.has-active-download ? T.tr("game_details.add_to_queue") : T.tr("game_details.download_now");
        clicked => {
            DownloadSettings.start();
        }
    }
}
