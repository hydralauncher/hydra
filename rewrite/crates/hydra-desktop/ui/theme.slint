// Design tokens copied from src/renderer/src/scss/globals.scss.

export global Theme {
    out property <color> background: #121212;
    out property <color> dark-background: #0d0d0d;
    out property <color> muted: #f0f1f7;
    out property <color> body: #d0d1d7;
    out property <color> border: rgba(255, 255, 255, 0.08);
    out property <color> success: #1c9749;
    out property <color> danger: #801d1e;
    out property <color> error: #e11d48;
    out property <color> warning: #ffc107;
    out property <color> brand-blue: #3e62c0;
    out property <length> body-size: 14px;
    out property <length> hint-size: 13px;
    out property <length> small-size: 12px;
    // Chromium doesn't inherit font-size into <button>: Hydra buttons render at 13.33px.
    out property <length> button-size: 13.33px;
    out property <float> disabled-opacity: 0.5;
    out property <float> active-opacity: 0.7;
}

