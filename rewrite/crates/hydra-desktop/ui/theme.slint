// One shared tooltip, like react-tooltip's portal. Anchors are in window coordinates.
export global Tip {
    in-out property <string> text;
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
    in-out property <string> place: "top";
    in-out property <bool> shown;
    in-out property <int> owner;

    public function show(id: int, text: string, x: length, y: length, w: length, h: length, place: string) {
        self.owner = id;
        self.text = text;
        self.anchor-x = x;
        self.anchor-y = y;
        self.anchor-width = w;
        self.anchor-height = h;
        self.place = place;
        self.shown = text != "";
    }

    public function hide(id: int) {
        if (self.owner == id) {
            self.shown = false;
        }
    }
}

// Unique ids for tooltip owners.
export global Ids {
    in-out property <int> next: 1;

    public function take() -> int {
        self.next += 1;
        return self.next;
    }
}
