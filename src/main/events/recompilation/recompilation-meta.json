  "spartanport": {
    "executable": {
      "win32": "SpartanPort.exe"
    },
    "rom": {
      "path": {
        "arg": ["--play"],
        "config": {
          "file": {
            "win32": "<base>/settings.json",
            "linux": "<xdgData>/spartanport/settings.json"
          },
          "key": ["game_dir"]
        }
      },
      "folder": ["eboot.bin", "sce_sys/param.sfo"],
      "titleIds": ["CUSA01623", "CUSA01715"],
      "extensions": []
    },
    "trophies": {
      "kind": "bitmask",
      "path": {
        "win32": "<base>/user/trophies.dat",
        "linux": "<xdgData>/spartanport/user/trophies.dat"
      }
    }
  },
