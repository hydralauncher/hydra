{
  "dusklight": {
    "rom": {
      "path": {
        "config": {
          "file": "<appData>/TwilitRealm/Dusklight/config.json",
          "key": ["backend.isoPath"]
        }
      },
      "extensions": [
        ".iso",
        ".gcm",
        ".ciso",
        ".gcz",
        ".nfs",
        ".rvz",
        ".wbfs",
        ".wia",
        ".tgc"
      ]
    }
  },
  "ico-pc": {
    "rom": {
      "path": {
        "arg": ["--iso", "{rom}"]
      },
      "extensions": [".iso", ".chd", ".bin", ".cue"]
    }
  },
  "super-mario-bros-remastered-public": {
    "rom": {
      "path": {
        "arg": ["-rom", "{rom}"]
      },
      "extensions": [".nes"]
    }
  },
  "shipwright": {
    "rom": {
      "path": {
        "arg": ["{rom}"]
      },
      "once": true,
      "imported": {
        "win32": ["<base>/oot.o2r", "<base>/oot-mq.o2r"],
        "linux": [
          "<xdgData>/soh/oot.o2r",
          "<xdgData>/soh/oot-mq.o2r",
          "<base>/oot.o2r",
          "<base>/oot-mq.o2r"
        ]
      },
      "extensions": [".z64", ".n64", ".v64"]
    }
  },
  "ghostship": {
    "rom": {
      "path": {
        "arg": ["{rom}"]
      },
      "once": true,
      "imported": {
        "win32": ["<base>/sm64.o2r"],
        "linux": ["<xdgData>/sm64/sm64.o2r", "<base>/sm64.o2r"]
      },
      "extensions": [".z64", ".n64", ".v64"],
      "format": "z64"
    }
  },
  "gen1recomp": {
    "rom": {
      "path": {
        "env": {
          "POKEPORT_IMPORT_ROM": "{rom}"
        }
      },
      "once": true,
      "extensions": [".gb"]
    }
  },
  "tenkaichi3decomp": {
    "rom": {
      "path": {
        "installer": ["Tenkaichi3Decomp-setup", "--install", "{rom}"]
      },
      "once": true,
      "imported": {
        "win32": ["<base>/gamedata/.installed"],
        "linux": ["<base>/gamedata/.installed"]
      },
      "extensions": [".iso"]
    }
  },
  "zelda64recomp": {
    "rom": {
      "copyTo": {
        "win32": "<winLocalAppData>/Zelda64Recompiled/mm.n64.us.1.0.z64",
        "linux": "<home>/.config/Zelda64Recompiled/mm.n64.us.1.0.z64"
      },
      "format": "z64",
      "extensions": [".z64", ".n64", ".v64"]
    }
  },
  "silent-hill-decomp": {
    "rom": {
      "copyTo": {
        "win32": "<base>/gamedata/{romName}",
        "linux": "<base>/gamedata/{romName}"
      },
      "extensions": [".bin"]
    }
  },
  "spaghettikart": {
    "hideConsole": true,
    "rom": {
      "copyTo": {
        "win32": "<base>/baserom.us.z64",
        "linux": "<base>/baserom.us.z64"
      },
      "imported": {
        "win32": ["<base>/mk64.o2r"],
        "linux": ["<base>/mk64.o2r", "<xdgData>/spaghettikart/mk64.o2r"]
      },
      "format": "z64",
      "extensions": [".z64", ".n64", ".v64"]
    }
  },
  "symphonyrecomp": {
    "executable": { "linux": "run.sh" },
    "rom": {
      "path": {
        "config": {
          "file": "<base>/settings.json",
          "key": ["system", "discPath"]
        }
      },
      "extensions": [".cue", ".chd"]
    }
  }
}
