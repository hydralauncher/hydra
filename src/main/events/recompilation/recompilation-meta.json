  "dusklight": {
    "rom": {
      "path": {
        "config": {
          "file": "<appData>/TwilitRealm/Dusklight/config.json",
          "key": ["backend.isoPath"]
        }
      },
      "extensions": [
        ".iso",
        ".gcm",
        ".ciso",
        ".gcz",
        ".nfs",
        ".rvz",
        ".wbfs",
        ".wia",
        ".tgc"
      ]
    }
  },
